    "title": "Jaws",
    "description":"Pioneering horror film",
    "genreId": "{{createGenre.response.body.id}}", 
    "releaseDate":"08.03.2026",
    "duration":3000,
    "thumbnailUrl":"https://google.com",
    "videoUrl":"https://google.com"
}


