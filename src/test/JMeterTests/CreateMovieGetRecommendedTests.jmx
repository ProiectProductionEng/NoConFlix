        </HTTPSamplerProxy>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Create Movie Request">
          <stringProp name="HTTPSampler.domain">humble-winner-v799qwgvpj73wwg6-8080.app.github.dev</stringProp>
          <stringProp name="HTTPSampler.path">/api/movies</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&#xd;
    &quot;title&quot;: &quot;The Nun2&quot;,&#xd;
    &quot;description&quot;:&quot;Filmed in Romania&quot;,&#xd;
    &quot;genreId&quot;: &quot;${__Random(1,10000)}&quot;&#xd;
    &quot;releaseDate&quot;:&quot;08.03.2026&quot;,&#xd;
    &quot;duration&quot;:${__Random(1,10000)}-5000,&#xd;
    &quot;thumbnailUrl&quot;:&quot;https://google.com&quot;,&#xd;
    &quot;videoUrl&quot;:&quot;https://google.com&quot;&#xd;
}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="Get Recommended Films Request">
